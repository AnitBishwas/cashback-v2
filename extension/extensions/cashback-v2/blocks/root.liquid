{% liquid
  assign root_id = 'cashback-page'
  if block.settings.widget
    assign root_id = 'widget'
  endif
%}

<div id="{{ root_id }}">
  {% liquid
    # Relative to entrypointsDir
    render 'vite-tag' with 'theme.css'
    if block.settings.widget
      render 'vite-tag' with 'widget.jsx'
    else
      render 'vite-tag' with 'landingPage.jsx'
    endif
  %}
</div>

{% schema %}
{
  "name": "Cashback extension",
  "target": "section",
  "settings": [
    {
      "type":"checkbox",
      "label":"Enable widget",
      "id":"widget"
    },
  ]
}
{% endschema %}

